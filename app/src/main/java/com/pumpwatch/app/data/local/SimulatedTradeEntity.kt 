package com.pumpwatch.app.data.local

import androidx.room.Entity
import androidx.room.PrimaryKey

@Entity(tableName = "simulated_trades")
data class SimulatedTradeEntity(
    @PrimaryKey
    val id: String,
    val coinId: String,
    val symbol: String,
    val name: String,
    val direction: String,
    val entryPrice: Double,
    val entryTimeMillis: Long,
    val highestPriceSinceEntry: Double,
    val lowestPriceSinceEntry: Double,
    val trailingStopPrice: Double,
    val hardStopLossPrice: Double,
    val takeProfitPrice: Double?,
    val status: String,
    val feePercent: Double,
    val stakeAmount: Double,
    val exitPrice: Double?,
    val exitTimeMillis: Long?,
    val exitReason: String?
)
